{
  "version": "v1",
  "hooks": [
    {
      "name": "pre-push check",
      "trigger": "manual",
      "description": "Manual pre-push safety check: verifies .kiro is not gitignored, no .env or data/raw.db is staged, no staged file exceeds 50 MB, and no secrets/API keys appear in staged files. Reports PASS/FAIL per check. Read-only; modifies nothing.",
      "action": {
        "type": "command",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand "
      }
    }
  ]
}
